PLAID_CLIENT_ID=
PLAID_SECRET=
APP_ORIGIN=http://127.0.0.1:3000

# Supabase (Project Settings → API). The publishable key is designed to be public.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only Postgres connection strings (Project Settings → Database → Connect).
# Transaction pooler (port 6543) for the app; session pooler or direct (port 5432) for migrations.
DATABASE_URL=
MIGRATION_DATABASE_URL=
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
